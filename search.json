---
layout: null
---
[
{% for post in site.posts %}  {
    "title": {{ post.title | jsonify }},
    "excerpt": {{ post.excerpt | strip_html | normalize_whitespace | jsonify }},
    "description": {{ post.description | default: "" | jsonify }},
    "content": {{ post.content | strip_html | normalize_whitespace | jsonify }},
    "url": {{ post.url | prepend: site.baseurl | jsonify }},
    "date": {{ post.date | date: "%b %-d, %Y" | jsonify }},
    "tags": {{ post.tags | jsonify }},
    "image": {{ post.image | default: "" | jsonify }},
    "readmin": {{ post.content | strip_html | number_of_words | divided_by: 250 | plus: 1 }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}]
